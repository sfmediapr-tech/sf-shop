# Stripe. Test keys look like sk_test_… and pk_test_….
# Without these the basket still works and checkout reports that payment is not
# configured, rather than failing silently.
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Where Stripe returns the customer after payment.
PUBLIC_SITE_URL=http://localhost:4340

# Enquiry forwarding. Without both of these, enquiries are still stored in
# .data/enquiries.jsonl — that file is the inbox until this is set.
RESEND_API_KEY=
ENQUIRY_FORWARD_TO=
ENQUIRY_FROM=enquiries@mysupplementfactory.com
