---
import { NAV, SITE } from '../data/site'
import BasketCount from '../islands/BasketCount'

interface Props { dark?: boolean }
const { dark = false } = Astro.props
const path = Astro.url.pathname
const on = (href: string) => path === href || (href !== '/' && path.startsWith(href))
---
<header class:list={['hdr', dark && 'hdr--dark']}>
  <div class="page hdr__inner">
    <a href="/" class="hdr__brand">
      <span class="hdr__mark">SF</span>
      <span class="hdr__co">{SITE.name}</span>
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul class="hdr__list">
        {NAV.map((item) => (
          <li class="hdr__item">
            <a href={item.href} aria-current={on(item.href) ? 'page' : undefined}>{item.label}</a>
            {item.children && (
              <ul class="hdr__sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__end">
      <BasketCount client:load />
      <a href="/quote" class="btn btn--primary btn--sm hdr__cta">Get a quote</a>

      <details class="hdr__mob">
        <summary aria-label="Menu"><span></span><span></span><span></span></summary>
        <div class="hdr__mobpanel">
          {NAV.map((item) => (
            <div class="hdr__mobgroup">
              <a href={item.href} class="hdr__moblead">{item.label}</a>
              {item.children && (
                <ul>{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
              )}
            </div>
          ))}
          <div class="hdr__mobgroup">
            <a href="/quote" class="hdr__moblead">Get a quote</a>
            <a href="/basket" class="hdr__moblead">Basket</a>
            <a href="/contact" class="hdr__moblead">Contact</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,.9);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .hdr--dark { background: rgba(16,16,16,.88); border-bottom-color: var(--rule-dark); color: var(--on-dark); }

  .hdr__inner { display: flex; align-items: center; gap: var(--s6); min-height: 66px; }
  .hdr__brand { display: flex; align-items: center; gap: var(--s3); text-decoration: none; flex-shrink: 0; }
  .hdr__mark {
    display: grid; place-items: center; width: 32px; height: 32px;
    background: var(--ink); color: var(--gold-hi); border-radius: 3px;
    font-size: 12px; font-weight: 800; letter-spacing: .04em; font-variation-settings: 'wdth' 88;
  }
  .hdr--dark .hdr__mark { background: var(--gold); color: var(--ink); }
  .hdr__co { font-size: var(--t-small); font-weight: 700; letter-spacing: -.01em; }

  .hdr__nav { margin-left: auto; }
  .hdr__list { display: flex; gap: var(--s5); list-style: none; margin: 0; padding: 0; }
  .hdr__item { position: relative; }
  .hdr__item > a { display: block; padding: var(--s4) 0; font-size: var(--t-small); font-weight: 600; text-decoration: none; }
  .hdr__item > a[aria-current='page'] { color: var(--gold-lo); }
  .hdr--dark .hdr__item > a[aria-current='page'] { color: var(--gold-hi); }

  .hdr__sub {
    position: absolute; top: 100%; left: -12px; min-width: 210px;
    list-style: none; margin: 0; padding: var(--s3);
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--rule); border-radius: var(--r-lg); box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .16s var(--ease), transform .16s var(--ease), visibility .16s;
  }
  .hdr__item:hover .hdr__sub, .hdr__item:focus-within .hdr__sub { opacity: 1; visibility: visible; transform: translateY(0); }
  .hdr__sub a { display: block; padding: var(--s2) var(--s3); border-radius: var(--r); font-size: var(--t-small); text-decoration: none; }
  .hdr__sub a:hover { background: var(--ground); }

  .hdr__end { display: flex; align-items: center; gap: var(--s4); flex-shrink: 0; margin-left: auto; }
  .hdr__nav + .hdr__end { margin-left: 0; }

  /* The mobile menu. Hidden wherever the full nav fits. */
  .hdr__mob { display: none; position: relative; }
  .hdr__mob summary {
    list-style: none; cursor: pointer;
    display: grid; gap: 4px; align-content: center;
    width: 34px; height: 34px; padding: 8px 6px;
    border: 1px solid var(--rule-2); border-radius: var(--r);
  }
  .hdr__mob summary::-webkit-details-marker { display: none; }
  .hdr__mob summary::marker { content: ''; }
  .hdr__mob summary span { display: block; height: 2px; background: var(--ink); border-radius: 2px; }
  .hdr--dark .hdr__mob summary { border-color: var(--rule-dark); }
  .hdr--dark .hdr__mob summary span { background: var(--on-dark); }
  .hdr__mob[open] summary { border-color: var(--gold); }

  .hdr__mobpanel {
    position: absolute; top: calc(100% + 10px); right: 0;
    width: min(84vw, 300px); max-height: 74vh; overflow-y: auto;
    display: grid; gap: var(--s5);
    padding: var(--s5);
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--rule); border-radius: var(--r-lg); box-shadow: var(--shadow-lift);
  }
  .hdr__mobgroup { display: grid; gap: var(--s2); }
  .hdr__moblead { font-size: var(--t-small); font-weight: 700; text-decoration: none; }
  .hdr__mobpanel ul { list-style: none; margin: 0; padding: 0 0 0 var(--s4); display: grid; gap: var(--s2); }
  .hdr__mobpanel ul a { font-size: var(--t-small); color: var(--ink-2); text-decoration: none; }
  .hdr__mobpanel a:hover { color: var(--gold-lo); }

  @media (max-width: 1080px) {
    .hdr__nav { display: none; }
    .hdr__mob { display: block; }
    .hdr__nav + .hdr__end { margin-left: auto; }
  }
  @media (max-width: 560px) {
    .hdr__inner { gap: var(--s3); min-height: 58px; }
    .hdr__co { display: none; }
    .hdr__mark { width: 28px; height: 28px; font-size: 11px; }
    .hdr__end { gap: var(--s3); }
    .hdr__cta { padding: var(--s2) var(--s3); }
    .hdr__basket { font-size: var(--t-micro); }
  }
</style>
