---
import Base from '../layouts/Base.astro'
import { CONTACT, COMMERCE_RULE } from '../data/site'

/* The endpoint redirects back here with a reason rather than swallowing a
   failure, so the visitor is told what to change. */
const ERRORS: Record<string, string> = {
  missing: 'We need at least your name and email to reply.',
  email: 'That email address does not look right — check it and send again.',
  storage: 'Something went wrong our end and the enquiry was not saved. Please email us directly.',
  unreadable: 'We could not read that submission. Please try again.',
}
const error = ERRORS[Astro.url.searchParams.get('error') ?? '']

/* Server-rendered, unlike the rest of the site: a prerendered page is built once
   with no query string, so the error the endpoint redirects back with would
   never appear. This page needs a server anyway, since the form it carries posts
   to one. */
export const prerender = false
---
<Base title="Contact — Supplement Factory" description="Talk to sales about manufacturing, or about anything you have bought in the shop.">
  <section class="section--tight">
    <div class="page">
      <span class="eyebrow">Contact</span>
      <h1>Tell us what you are making.</h1>
    </div>
  </section>

  <section class="section--tight">
    <div class="page split">
      <div class="stack-6">
        <div>
          <h2 class="micro" style="margin-bottom: var(--s3)">Email</h2>
          <p><a href={`mailto:${CONTACT.salesEmail}`} class="big-link">{CONTACT.salesEmail}</a></p>
          <p class="small" style="color: var(--ink-3)">
            {CONTACT.namedPerson ?? 'A named member of the team'} replies, usually within
            {' '}{CONTACT.responseTime.toLowerCase()}.
          </p>
        </div>

        <div>
          <h2 class="micro" style="margin-bottom: var(--s3)">Which is it?</h2>
          <p class="small"><strong>Buying outright:</strong> {COMMERCE_RULE.buyable} <a href="/shop">Go to the shop</a>.</p>
          <p class="small" style="margin-top: var(--s3)"><strong>Needs a quote:</strong> {COMMERCE_RULE.quoted} <a href="/quote">Build a specification</a>.</p>
        </div>
      </div>

      <form class="form" method="post" action="/api/enquiry">
        <h2>Send an enquiry</h2>

        {error && <p class="note note--pencil small" role="alert">{error}</p>}

        <label>Your name<input type="text" name="name" required autocomplete="name" /></label>
        <label>Email<input type="email" name="email" required autocomplete="email" /></label>
        <label>Brand or company<input type="text" name="company" autocomplete="organization" /></label>

        <label>What are you making?
          <textarea name="brief" rows="4" placeholder="Format, rough volume, the markets you sell into, and when you want to launch"></textarea>
        </label>

        <!-- Honeypot. Hidden from people, irresistible to bots. -->
        <div class="form__hp" aria-hidden="true">
          <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <button type="submit" class="btn btn--primary">Send enquiry</button>
        <p class="micro form__note">
          We will come back with what we need to quote it properly, rather than a number we would
          have to revise.
        </p>
      </form>
    </div>
  </section>
</Base>

<style>
  .big-link { font-size: var(--t-h3); font-weight: 700; color: var(--gold-lo); text-decoration: none; }
  .big-link:hover { text-decoration: underline; }

  .form {
    display: grid; gap: var(--s4); padding: var(--s6);
    background: var(--ground); border: 1px solid var(--rule); border-radius: var(--r-lg);
  }
  .form label { display: grid; gap: var(--s2); font-size: var(--t-small); font-weight: 600; }
  .form input, .form textarea {
    font: inherit; font-size: var(--t-body); font-weight: 400; padding: var(--s3);
    border: 1px solid var(--rule-2); border-radius: var(--r); background: var(--paper); color: var(--ink);
  }
  .form textarea { resize: vertical; }
  .form button { justify-self: start; margin-top: var(--s2); }
  .form__note { color: var(--ink-3); margin: 0; }
  .form__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>
